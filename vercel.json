{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/x402-paywalled-api/(.*)",
      "destination": "/api/x402-paywalled-api?path=$1"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
